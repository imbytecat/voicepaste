{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "draft": true,
  "force-tag-creation": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "include-v-in-release-name": true,
  "always-update": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "新增",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "修复",
      "hidden": false
    },
    {
      "type": "perf",
      "section": "性能",
      "hidden": false
    },
    {
      "type": "deps",
      "section": "依赖",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "文档",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "重构",
      "hidden": true
    },
    {
      "type": "test",
      "section": "测试",
      "hidden": true
    },
    {
      "type": "build",
      "section": "构建",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "维护",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "voicepaste",
      "component": "VoicePaste",
      "version-file": "version.txt",
      "pull-request-title-pattern": "chore(release): ${version}",
      "extra-files": [
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == \"voicepaste\")].version"
        }
      ]
    }
  }
}
